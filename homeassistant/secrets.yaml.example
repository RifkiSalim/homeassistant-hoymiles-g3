# Copy to your Home Assistant config/secrets.yaml (merge with existing secrets)

# Ethernet IP of the Hoymiles data transfer stick (DTS-WL-G3 / factory DTU stick).
# Modbus TCP is on the stick's RJ45 port (typically 502). Wi-Fi does not expose Modbus.
hoymiles_host: 192.168.1.50
hoymiles_port: 502
hoymiles_unit: 1
