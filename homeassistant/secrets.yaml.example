# Copy to your Home Assistant config/secrets.yaml (merge with existing secrets)

# IP/hostname of your external DTU or Modbus-TCP-to-RS485 gateway (Ethernet), NOT the inverter.
hoymiles_host: 192.168.1.50
hoymiles_port: 502
# Modbus unit/slave ID on the 485_2 bus (often 1; Hoymiles DTU-Pro RS485 mode uses 101–254).
hoymiles_unit: 1
